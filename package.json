{
  "name": "react-example",
  "private": true,
  "version": "11.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:steering": "node --experimental-strip-types scripts/test-steering-dynamics.mjs",
    "test:director": "node --experimental-strip-types scripts/test-director-v60.mjs",
    "test:interactive": "node --experimental-strip-types scripts/test-interactive-physics.mjs",
    "test:interactive:extended": "node --experimental-strip-types scripts/test-interactive-extended.mjs",
    "test:v7": "node --experimental-strip-types scripts/test-v70.mjs",
    "test:corolla": "node scripts/test-corolla-v75.mjs && node --experimental-strip-types scripts/test-corolla-physics.mjs",
    "test:v76": "node scripts/test-v76.mjs && npm run test:interactive && npm run test:corolla",
    "test:v77": "node scripts/test-v77.mjs && npm run test:v76",
    "test:v78": "node --experimental-strip-types scripts/test-v78.mjs && npm run test:v77",
    "test:v80": "node --experimental-strip-types scripts/test-v80.mjs && npm run test:v78",
    "test:v82": "node --experimental-strip-types scripts/test-v82-suspension.mjs && npm run test:v80",
    "test:v83": "node --experimental-strip-types scripts/test-v83-physics.mjs && npm run test:v82",
    "test:v84": "node --experimental-strip-types scripts/test-v84-physics.mjs && node scripts/test-v84-integration.mjs",
    "test:v85": "node --experimental-strip-types scripts/test-v85-interpolation.mjs && node scripts/test-v85-integration.mjs && npm run test:v84",
    "test:v87": "node --experimental-strip-types scripts/test-v87-dynamics.mjs && npm run test:v86",
    "test:v86": "node --experimental-strip-types scripts/test-v86-abs.mjs && node scripts/test-v86-audio.mjs && npm run test:v85",
    "test:v88": "node --experimental-strip-types scripts/test-v88-catalog.mjs && npm run test:v87",
    "test:v89": "node --experimental-strip-types scripts/test-v89-advanced.mjs && npm run test:v88",
    "test:v91": "node --experimental-strip-types scripts/test-v91.mjs && npm run test:v89",
    "test:v92": "node --experimental-strip-types scripts/test-v92-curved-routes.mjs && npm run test:v91",
    "test:v921": "node scripts/test-v921-startup-imports.mjs && npm run test:v92",
    "test:v95": "node --experimental-strip-types scripts/test-v95-driving-iq.mjs && npm run test:v93",
    "test:v93": "node --experimental-strip-types scripts/test-v93-finish-and-viaduct.mjs && npm run test:v92",
    "test:v96": "node --experimental-strip-types scripts/test-v96-start-and-insights.mjs && npm run test:v95",
    "test:v11": "node scripts/test-v11-mobile-consolidated.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
